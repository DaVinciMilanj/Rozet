# رونوشت بگیرید به .env و پر کنید. خود .env هیچ‌وقت کامیت نمی‌شود.

DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# sqlite یا postgresql
DATABASE_ENGINE=sqlite
# DATABASE_NAME=rozet
# DATABASE_USER=rozet
# DATABASE_PASSWORD=
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432

# CSRF_TRUSTED_ORIGINS=https://your-domain.ir,https://www.your-domain.ir

# ── سئو ──
# نشانی اصلی سایت، با https و بدون / پایانی. روی سرور حتماً پر شود.
# SITE_URL=https://your-domain.ir
# روی سرور آزمایشی False تا گوگل نسخه‌ی تست را ایندکس نکند.
# SEO_INDEXING=True
# کد تأیید Search Console و Bing Webmaster (فقط مقدار content)
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# روی سرور پشت nginx: 1 — تا IP واقعی کاربر در لاگ ورود بنشیند.
# TRUSTED_PROXY_COUNT=1

# درگاه پرداخت (فعلاً آزمایشی) و مرچنت زرین‌پال
# PAYMENT_GATEWAY=apps.payments.gateway.SandboxGateway
# ZARINPAL_MERCHANT_ID=

# حداقل طول رمز عبور
# PASSWORD_MIN_LENGTH=6

# فقط توسعه: صفحه‌ی دیباگ ۴۰۴ جنگو به‌جای ۴۰۴ سایت
# DEBUG_ERROR_PAGES=False

# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=ROZET <no-reply@your-domain.ir>
